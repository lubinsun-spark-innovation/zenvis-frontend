{
  "type": "page",
  "title": "插件数据总览",
  "className": "zv-page zv-workspace",
  "body": [
    {
      "type": "grid",
      "columns": [
        {
          "md": 3,
          "sm": 6,
          "xs": 12,
          "body": {
            "type": "card",
            "className": "zv-metric-card",
            "body": {
              "type": "tpl",
              "tpl": "<span>资产总数</span><strong>${assetTotal || 0}</strong><span>当前纳管资产</span>"
            }
          }
        },
        {
          "md": 3,
          "sm": 6,
          "xs": 12,
          "body": {
            "type": "card",
            "className": "zv-metric-card",
            "body": {
              "type": "tpl",
              "tpl": "<span>正常运行</span><strong>${healthy || 0}</strong><span>实时健康状态</span>"
            }
          }
        }
      ]
    },
    {
      "type": "chart",
      "className": "zv-chart-card",
      "height": 360,
      "config": {
        "tooltip": { "trigger": "axis", "confine": true },
        "grid": { "left": 24, "right": 24, "top": 56, "bottom": 32, "containLabel": true },
        "xAxis": { "type": "category", "data": "${labels || []}" },
        "yAxis": { "type": "value", "minInterval": 1 },
        "series": [{ "type": "line", "smooth": true, "data": "${values || []}" }]
      }
    }
  ]
}
